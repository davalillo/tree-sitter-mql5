{
  "name": "tree-sitter-mql5",
  "version": "0.1.0",
  "description": "MQL4/MQL5 grammar for tree-sitter",
  "repository": "https://github.com/mskelton/tree-sitter-mql5.git",
  "main": "bindings/node",
  "keywords": [
    "tree-sitter",
    "parser",
    "mql4",
    "mql5"
  ],
  "author": "Mark Skelton",
  "license": "ISC",
  "scripts": {
    "generate": "tree-sitter generate",
    "build:highlights": "node scripts/build-highlights.js",
    "test": "tree-sitter test && tree-sitter parse examples/* --quiet --time",
    "regression": "bash test/regression/run-regression.sh",
    "regression:corpus": "bash test/regression/download-corpus.sh"
  },
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "prettier": "^2.8.1",
    "tree-sitter-cli": "^0.25.10"
  },
  "tree-sitter": [
    {
      "scope": "source.mql5",
      "file-types": [
        "mq5",
        "mqh",
        "mq4"
      ],
      "highlights": [
        "queries/highlights.scm",
        "node_modules/tree-sitter-cpp/queries/highlights.scm"
      ]
    }
  ]
}
